---
interface Props {
  img: string;
  title: string;
}
const { img, title } = Astro.props;
---

<section
  class="flex h-[400px] items-center justify-center bg-center bg-cover text-center"
  style={`background-image:url('${img}'); background-color: #9ca3af;`}
>
  <h1 class="px-4 text-3xl font-bold text-white md:text-5xl [text-shadow:2px_2px_4px_rgba(0,0,0,0.7)]">
    {title}
  </h1>
</section>
