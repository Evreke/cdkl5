---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import '@fontsource/noto-sans/cyrillic-400.css';
import '@fontsource/noto-sans/cyrillic-500.css';
import '@fontsource/noto-sans/cyrillic-700.css';
import '@fontsource/noto-sans/latin-400.css';
import '@fontsource/noto-sans/latin-500.css';
import '@fontsource/noto-sans/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
// Vite hashes font filenames, so resolve the real built URLs at build time for preload.
import cyr400Url from '@fontsource/noto-sans/files/noto-sans-cyrillic-400-normal.woff2?url';
import cyr700Url from '@fontsource/noto-sans/files/noto-sans-cyrillic-700-normal.woff2?url';

interface Props {
  pageTitle: string;
  description?: string;
  ogImage?: string;
  activePath: string;
}

const { pageTitle, description = '', ogImage = '/img/hand.jpg', activePath } = Astro.props;

const SITE_NAME = 'Сообщество CDKL5 — Россия';
// Homepage keeps its own SEO title (it must carry the «синдром CDKL5» keyword);
// inner pages follow the «<page> — Сообщество CDKL5» template.
const fullTitle = activePath === '/' ? pageTitle : `${pageTitle} — Сообщество CDKL5`;
const site = Astro.site ?? new URL('https://cdkl5-russia.ru');
const canonical = new URL(Astro.url.pathname, site);

// Social parsers handle JPG more reliably than WebP. If the page passes a .webp
// and a .jpg sibling exists in public/, prefer the JPG and keep the WebP as a
// second og:image entry. Missing sibling -> keep the original image (no crash).
const jpgSibling = ogImage.replace(/\.webp$/i, '.jpg');
const jpgSiblingPaths =
  jpgSibling === ogImage
    ? []
    : [
        fileURLToPath(new URL(`../../public${jpgSibling}`, import.meta.url)),
        `${process.cwd()}/public${jpgSibling}`,
      ];
const hasJpgSibling = jpgSiblingPaths.some((p) => fs.existsSync(p));
const ogImages = hasJpgSibling ? [jpgSibling, ogImage] : [ogImage];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImages.map((img) => <meta property="og:image" content={new URL(img, site)} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={cyr400Url} />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={cyr700Url} />
    <link rel="icon" href="/favicon.png" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />

    <!-- Yandex.Metrika counter -->
    <script is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

      ym(100658848, 'init', {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: true,
      });
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/100658848" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-800 antialiased">
    <Header activePath={activePath} />
    <main class="flex-grow pt-[100px]">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
